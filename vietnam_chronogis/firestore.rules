rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function isActiveUser() {
      return signedIn()
        && userDoc(request.auth.uid).data.status == 'active';
    }

    function isAdmin() {
      return isActiveUser()
        && userDoc(request.auth.uid).data.globalRole == 'admin';
    }

    function campaignDoc(campaignId) {
      return get(/databases/$(database)/documents/campaigns/$(campaignId));
    }

    function participantDoc(campaignId, uid) {
      return get(/databases/$(database)/documents/campaigns/$(campaignId)/participants/$(uid));
    }

    function isCampaignManager(campaignId) {
      return isActiveUser()
        && (
          campaignDoc(campaignId).data.ownerId == request.auth.uid
          || (
            participantDoc(campaignId, request.auth.uid).data.status == 'approved'
            && participantDoc(campaignId, request.auth.uid).data.role in ['owner', 'organizer']
          )
        );
    }

    function userCreateShape(uid) {
      return request.resource.data.uid == uid
        && request.resource.data.globalRole == 'user'
        && request.resource.data.status == 'active';
    }

    function validManagedSchoolShape() {
      return request.resource.data.keys().hasAll([
          'name',
          'address',
          'location',
          'checkInRadiusMeters',
          'active',
          'createdBy',
          'createdAt',
          'updatedAt',
        ])
        && request.resource.data.keys().hasOnly([
          'name',
          'address',
          'location',
          'checkInRadiusMeters',
          'active',
          'createdBy',
          'createdAt',
          'updatedAt',
        ])
        && request.resource.data.name is string
        && request.resource.data.address is string
        && request.resource.data.location is latlng
        && request.resource.data.checkInRadiusMeters is number
        && request.resource.data.checkInRadiusMeters > 0
        && request.resource.data.checkInRadiusMeters <= 1000
        && request.resource.data.active is bool;
    }

    function participantCreateShape(campaignId, uid) {
      return request.resource.data.userId == uid
        && (
          (
            request.resource.data.status == 'pending'
            && request.resource.data.role == 'participant'
          )
          || (
            campaignDoc(campaignId).data.ownerId == request.auth.uid
            && uid == request.auth.uid
            && request.resource.data.status == 'approved'
            && request.resource.data.role == 'owner'
            && request.resource.data.approvedBy == request.auth.uid
          )
        );
    }

    function validCampaignShape() {
      return request.resource.data.keys().hasAll([
          'title',
          'description',
          'schoolId',
          'ownerId',
          'status',
          'startAt',
          'endAt',
          'createdAt',
          'updatedAt',
        ])
        && request.resource.data.keys().hasOnly([
          'title',
          'description',
          'schoolId',
          'ownerId',
          'status',
          'startAt',
          'endAt',
          'createdAt',
          'updatedAt',
        ])
        && request.resource.data.title is string
        && request.resource.data.description is string
        && request.resource.data.schoolId is string
        && request.resource.data.ownerId is string
        && request.resource.data.status in ['draft', 'published', 'ongoing', 'completed', 'cancelled']
        && request.resource.data.startAt is timestamp
        && request.resource.data.endAt is timestamp
        && request.resource.data.startAt < request.resource.data.endAt;
    }

    function validCampaignUpdate() {
      return validCampaignShape()
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    function validEventShape() {
      return request.resource.data.keys().hasAll([
          'name',
          'schoolId',
          'description',
          'startAt',
          'endAt',
          'checkInOpenAt',
          'checkInCloseAt',
          'status',
          'createdBy',
          'createdAt',
          'updatedAt',
        ])
        && request.resource.data.keys().hasOnly([
          'name',
          'schoolId',
          'description',
          'startAt',
          'endAt',
          'checkInOpenAt',
          'checkInCloseAt',
          'checkInRadiusMeters',
          'status',
          'createdBy',
          'createdAt',
          'updatedAt',
        ])
        && request.resource.data.name is string
        && request.resource.data.schoolId is string
        && request.resource.data.description is string
        && request.resource.data.status in ['draft', 'published', 'ongoing', 'completed', 'cancelled']
        && request.resource.data.createdBy is string
        && request.resource.data.startAt is timestamp
        && request.resource.data.endAt is timestamp
        && request.resource.data.checkInOpenAt is timestamp
        && request.resource.data.checkInCloseAt is timestamp
        && request.resource.data.startAt < request.resource.data.endAt
        && request.resource.data.checkInOpenAt <= request.resource.data.checkInCloseAt
        && request.resource.data.checkInCloseAt <= request.resource.data.endAt
        && (
          !request.resource.data.keys().hasAny(['checkInRadiusMeters'])
          || (
            request.resource.data.checkInRadiusMeters is number
            && request.resource.data.checkInRadiusMeters > 0
            && request.resource.data.checkInRadiusMeters <= 1000
          )
        );
    }

    function validEventUpdate() {
      return validEventShape()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt;
    }

    match /users/{uid} {
      allow read: if isSelf(uid) || isAdmin();
      allow create: if isSelf(uid) && userCreateShape(uid);
      allow update: if isSelf(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'photoUrl', 'updatedAt'])
        && request.resource.data.globalRole == resource.data.globalRole
        && request.resource.data.status == resource.data.status;
      allow delete: if false;
    }

    match /managed_schools/{schoolId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser()
        && validManagedSchoolShape()
        && request.resource.data.createdBy == request.auth.uid;
      allow update: if isActiveUser()
        && validManagedSchoolShape()
        && request.resource.data.createdBy == resource.data.createdBy
        && (resource.data.createdBy == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    match /campaigns/{campaignId} {
      allow read: if isActiveUser();
      allow create: if isActiveUser()
        && validCampaignShape()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.status in ['draft', 'published'];
      allow update: if isCampaignManager(campaignId)
        && validCampaignUpdate();
      allow delete: if campaignDoc(campaignId).data.ownerId == request.auth.uid || isAdmin();

      match /events/{eventId} {
        allow read: if isActiveUser();
        allow create, update: if isCampaignManager(campaignId)
          && (
            !exists(/databases/$(database)/documents/campaigns/$(campaignId)/events/$(eventId))
            ? validEventShape()
            : validEventUpdate()
          );
        allow delete: if isCampaignManager(campaignId);
      }

      match /participants/{uid} {
        allow read: if isSelf(uid) || isCampaignManager(campaignId);
        allow create: if isSelf(uid)
          && participantCreateShape(campaignId, uid);
        allow update: if isCampaignManager(campaignId)
          && request.resource.data.userId == uid
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.role in ['participant', 'staff', 'organizer']
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['status', 'role', 'approvedAt', 'approvedBy', 'updatedAt'])
          && request.resource.data.approvedBy == request.auth.uid;
        allow delete: if false;
      }

      match /events/{eventId}/checkins/{uid} {
        allow read: if isSelf(uid) || isCampaignManager(campaignId);
        allow create, update, delete: if false;
      }
    }
  }
}
